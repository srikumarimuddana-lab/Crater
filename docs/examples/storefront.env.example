# Example for apps/storefront/.env.local (ignored by Git). Fixture mode works with no keys.
# The authoritative, fully documented list is apps/storefront/.env.example.
COMMERCE_PROVIDER=fixture          # fixture | stripe
COMMERCE_DB=memory                 # memory | postgres
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (optional; local or a free hosted database the owner chooses)
DATABASE_URL=

# Stripe TEST keys only (sk_test_...). Live keys are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
