# Future apps/storefront/.env.local. Fixture mode works without store credentials.
COMMERCE_PROVIDER=fixture
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set these only when connecting the selected development/preview Shopify store.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_VERSION=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Use reviewed store checkout hosts when implementing the redirect validator.
SHOPIFY_ALLOWED_CHECKOUT_HOSTS=
