{
  "name": "crater-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Crater skincare storefront (Phase 1: static foundation, fixture data)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "admin:create-owner": "node db/admin-create-owner.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:pg": "bash scripts/with-test-postgres.sh"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.56.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
