# Crater storefront environment. Copy to .env.local (git-ignored) and fill in locally.
# Never put real secrets in this file and never prefix a secret with NEXT_PUBLIC_.
# With none of this set the app runs in fixture mode: in-memory sample catalog,
# carts work, checkout is refused (FIXTURE_MODE), nothing can be charged.

# --- Commerce mode -----------------------------------------------------------
# fixture (default) | stripe. "stripe" needs STRIPE_SECRET_KEY below; without a usable
# key the app stays in fixture mode. Mode is derived from the key prefix:
#   sk_test_/rk_test_ -> stripe-test    sk_live_/rk_live_ -> stripe-live
COMMERCE_PROVIDER=fixture

# --- Stripe (TEST mode only until the owner decides otherwise) ---------------
# Server-only secret key. Use a sk_test_ key. A sk_live_ key is REFUSED unless
# STRIPE_ALLOW_LIVE=true is also set.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). For local testing run
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# and paste the secret it prints. Orders are only created by this webhook.
STRIPE_WEBHOOK_SECRET=
# Explicit opt-in to live keys. Leave unset/false in development and previews.
STRIPE_ALLOW_LIVE=false

# --- Site origin ---------------------------------------------------------------
# Public origin used for Stripe success/cancel URLs (not a secret). https, or http for
# localhost only. No trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-only override, read at runtime and preferred over NEXT_PUBLIC_SITE_URL
# (which is inlined at BUILD time). Same rules: https, or http for localhost only.
# SITE_URL=

# --- Persistence ---------------------------------------------------------------
# memory (default): seeded in-process sample data, lost on restart, single instance only.
# postgres: durable; requires DATABASE_URL and `npm run db:migrate && npm run db:seed`.
COMMERCE_DB=memory

# Postgres connection string used by the running app (server-side only).
# Supabase: use the transaction-mode pooler string (port 6543) for serverless. The app
# is pooler-safe: unnamed parameterized queries, transaction-scoped row locks only, no
# session state (no SET, session advisory locks, LISTEN/NOTIFY or temp tables).
# All tables live in the `commerce` schema (not `public`), have row level security enabled
# with no policies, and the app connects as the database owner (which bypasses RLS), so
# the Supabase REST API with the public anon key cannot read or write them.
# Example shape only: postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=

# Optional direct or session-mode connection (Supabase port 5432) used ONLY by
# `npm run db:migrate` and `npm run db:seed`. Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=

# TLS. An explicit sslmode in the URL is honoured and takes precedence. Setting
# DATABASE_SSL=require forces TLS with certificate verification ({rejectUnauthorized: true}).
# Certificate verification is never disabled. Supabase requires TLS.
DATABASE_SSL=

# Max connections in this app's pg Pool (1-20, default 3). Keep small behind a pooler.
DATABASE_POOL_MAX=3

# --- Test-only Stripe endpoint override -----------------------------------------
# Points the Stripe SDK at a fake Stripe (the integration suite uses http://127.0.0.1:12111).
# TEST ONLY: honoured only when STRIPE_SECRET_KEY starts with sk_test_ AND the host is
# 127.0.0.1, localhost or ::1; otherwise ignored with a redacted warning. Never set in deployed envs.
# STRIPE_API_BASE=

# --- Tests ---------------------------------------------------------------------
# Throwaway database for the Postgres repository tests (they are skipped when unset).
# The database name must contain "test"; the tests DROP and recreate the commerce schema.
# TEST_DATABASE_URL=postgresql://USER@127.0.0.1:PORT/crater_test
# `npm run test:integration` needs TEST_DATABASE_URL (name must contain "test") and runs migrate,
# seed, a build into .next-integration, and Playwright on port 3300. `npm run test:integration:pg`
# does the same against a throwaway local Postgres 16 that it creates and removes.

# --- Admin (staff console at /admin) ---------------------------------------------
# Built-in sign-in now (scrypt passwords + authenticator-app TOTP); Supabase Auth later.
ADMIN_AUTH_PROVIDER=builtin
# REQUIRED. 32 random bytes, base64: `openssl rand -base64 32`. Encrypts TOTP secrets at rest (AES-256-GCM).
# Admin refuses to start if it is missing, not 32 bytes, or visibly weak. Server-only; never NEXT_PUBLIC_*.
# Losing it means every staff member must re-enrol their authenticator app.
ADMIN_SECRET_KEY=
# Used once by `npm run admin:create-owner` (the password is typed or piped on stdin, never set here).
ADMIN_OWNER_EMAIL=
# IANA timezone for "today" and sales by day on the Overview. Owner decision: Saskatchewan, no daylight saving.
TIMEZONE=America/Regina
# Optional: force Secure cookies on/off. Default: on when SITE_URL / NEXT_PUBLIC_SITE_URL is https (cookie is then __Host-crater_admin).
# ADMIN_COOKIE_SECURE=
# TEST/DEV ONLY, honoured only with COMMERCE_DB=memory and REFUSED with postgres. JSON object or array of
# {"email","password"(12+ chars),"role","totpSecret"(base32),"name"?}. Seeds staff with MFA already enrolled
# so e2e tests can sign in by computing TOTP codes. Never set this anywhere real.
# ADMIN_DEV_STAFF=

# Sales tax (docs/tax.md): GST/HST/SK PST are charged with fixed Stripe Tax Rate objects (not Stripe Tax). Before the first
# checkout on a Stripe account, create them once with a test key (idempotent; re-run after any rate change):
#   STRIPE_SECRET_KEY=sk_test_... npm run stripe:tax-rates
# It refuses live keys unless STRIPE_ALLOW_LIVE=true. Checkout looks the rates up by metadata.crater_tax_key and fails safely
# (PAYMENT_PROVIDER_UNAVAILABLE) if they are missing. Second staff member: npm run admin:create-staff -- --role FULFILMENT --email <email>
